{
	email {$EMAIL_ADMIN:admin@localhost}
	default_sni {$DOMAIN}
	log {
		output stdout
		format json
	}
}

{$DOMAIN}:443 {
	tls {
		issuer internal
	}

	header {
		Strict-Transport-Security "max-age=31536000;"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
	}

	handle /health {
		respond "OK" 200
	}

	# /v1/*: API OpenAI-compat. Es el MISMO modelo que /ollama (Qwen3.6-35B-A3B).
	@llama_api {
		path /v1/*
	}
	handle @llama_api {
		@valid_key {
			header X-API-Key "{$OLLAMA_API_KEY}"
		}
		handle @valid_key {
			reverse_proxy qwen:8080 {
				transport http {
					response_header_timeout 10m
				}
			}
		}
		respond `{"error": "Access denied. Invalid API Key."}` 401
	}

	# /ollama/*: alias legacy. NO es "otro modelo": apunta al MISMO qwen:8080 que /v1.
	# Lo consume aios-agent y la ruta va escrita en las ISOs ya distribuidas, asi que
	# NO retirar sin actualizar aios-agent/setup.py y reconstruir la ISO.
	@ollama_api {
		path /ollama/*
	}
	handle @ollama_api {
		@valid_key_ollama {
			header X-API-Key "{$OLLAMA_API_KEY}"
		}
		handle @valid_key_ollama {
			handle_path /ollama/* {
				reverse_proxy qwen:8080 {
					transport http {
						response_header_timeout 10m
					}
				}
			}
		}
		respond `{"error": "Access denied. Invalid API Key."}` 401
	}

	handle {
		respond `{"error": "not found"}` 404
	}
}
